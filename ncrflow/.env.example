# Copy this file to .env and change SECRET_KEY. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the Postgres container in docker-compose.yml
DATABASE_URL=postgres://ncrflow:ncrflow@localhost:5432/ncrflow

REDIS_URL=redis://localhost:6379/0

# Prints emails in the terminal instead of sending them
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ncrflow <no-reply@localhost>
